MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_real_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://mhstore:mhstore@127.0.0.1:5432/mhstore?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase
JWT_TOKEN_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Origine du frontend Next.js autorisée en cross-origin (regex). En dev,
# le serveur Next tourne typiquement sur localhost:3000.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:3000)?$'
###< nelmio/cors-bundle ###

###> app/frontend ###
# URL du frontend Next.js — utilisée pour construire les liens de retour
# après paiement PAPI (successUrl/failureUrl) et le lien "Retour au site"
# dans l'admin.
FRONTEND_URL=http://localhost:3000
###< app/frontend ###

###> app/papi ###
PAPI_API_KEY=change_me_papi_api_key
PAPI_API_URL=https://app.papi.mg/dashboard/api
PAPI_TEST_MODE=true
###< app/papi ###

###> app/super-admin ###
SUPER_ADMIN_OVERRIDE_CODE=change_me
###< app/super-admin ###
