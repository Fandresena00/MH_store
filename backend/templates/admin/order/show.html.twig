{% extends 'admin/base.html.twig' %}
{% block header_title %}Commande {{ order.reference }}{% endblock %}

{% block admin_body %}
    <a href="{{ path('admin_order_index') }}" class="btn-link text-sm">← Toutes les commandes</a>

    <div class="mt-6" style="display: grid; grid-template-columns: 1fr; gap: 24px;">
        <div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
            <div class="card">
                <h2 style="font-size: 1.1rem;" class="mb-4">Articles</h2>
                {% for item in order.items %}
                    <div class="flex items-center gap-3 mb-4">
                        <div class="swatch-thumb" style="background-image: linear-gradient(135deg, {{ item.product.colorFrom }}, {{ item.product.colorTo }});"></div>
                        <div style="flex:1;">
                            <p class="text-sm">{{ item.product.name }}</p>
                            <p class="text-xs text-soft">Qté {{ item.quantity }} × {{ item.unitPrice|number_format(0, ',', ' ') }} Ar</p>
                        </div>
                        <span class="text-sm">{{ item.lineTotal|number_format(0, ',', ' ') }} Ar</span>
                    </div>
                {% endfor %}
                <hr style="border: none; border-top: 1px solid var(--line); margin: 16px 0;">
                <div class="flex justify-between text-sm"><span>Sous-total</span><span>{{ order.subtotal|number_format(0, ',', ' ') }} Ar</span></div>
                <div class="flex justify-between text-sm"><span>Livraison</span><span>{{ order.shippingCost|number_format(0, ',', ' ') }} Ar</span></div>
                <div class="flex justify-between mt-6" style="font-family: var(--font-display); font-size: 1.15rem;"><span>Total</span><span>{{ order.total|number_format(0, ',', ' ') }} Ar</span></div>
            </div>

            <div class="card">
                <p class="text-xs" style="font-weight:700; text-transform:uppercase; color: var(--coral-deep); margin-bottom: 8px;">Client</p>
                <p class="text-sm">{{ order.user ? order.user.fullName : 'Commande invité' }}</p>
                <p class="text-sm text-soft">{{ order.user ? order.user.email : order.guestEmail }}</p>
                <hr style="border: none; border-top: 1px solid var(--line); margin: 16px 0;">
                <p class="text-xs" style="font-weight:700; text-transform:uppercase; color: var(--coral-deep); margin-bottom: 8px;">Paiement PAPI</p>
                <p class="text-sm">{{ order.paymentMethod }}</p>
                <p class="text-sm {{ order.paymentStatus == 'success' ? 'text-success' : (order.paymentStatus == 'failed' ? 'text-error' : 'text-soft') }}">
                    {{ order.paymentStatus == 'success' ? '✓ Payé' : (order.paymentStatus == 'failed' ? '✕ Échoué' : '⏳ En attente de confirmation') }}
                </p>
                <hr style="border: none; border-top: 1px solid var(--line); margin: 16px 0;">
                <p class="text-xs" style="font-weight:700; text-transform:uppercase; color: var(--coral-deep); margin-bottom: 8px;">Livraison</p>
                <p class="text-sm text-soft">{{ order.shippingAddress }}<br>{{ order.shippingCity }}</p>
            </div>

            <div class="card">
                <p class="text-xs" style="font-weight:700; text-transform:uppercase; color: var(--coral-deep); margin-bottom: 12px;">Statut de la commande</p>
                <form action="{{ path('admin_order_update_status', {id: order.id}) }}" method="post" class="flex gap-2">
                    <select name="status">
                        {% for key, label in statuses %}
                            <option value="{{ key }}" {{ order.status == key ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary">OK</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
