{% extends 'admin/base.html.twig' %}
{% block header_title %}{{ post.id ? "Modifier l'article" : 'Nouvel article' }}{% endblock %}

{% block admin_body %}
    <div class="max-w-2xl">
        {{ form_start(form) }}
            <div class="card">
                <div class="form-grid-2">
                    <div class="field-group">{{ form_label(form.title) }}{{ form_widget(form.title) }}{{ form_errors(form.title) }}</div>
                    <div class="field-group">{{ form_label(form.slug) }}{{ form_widget(form.slug) }}{{ form_errors(form.slug) }}</div>
                </div>
                <div class="form-grid-2">
                    <div class="field-group">{{ form_label(form.category) }}{{ form_widget(form.category) }}</div>
                    <div class="field-group">{{ form_label(form.readTime) }}{{ form_widget(form.readTime) }}</div>
                </div>
                <div class="form-grid-2">
                    <div class="field-group">{{ form_label(form.coverFrom) }}{{ form_widget(form.coverFrom) }}</div>
                    <div class="field-group">{{ form_label(form.coverTo) }}{{ form_widget(form.coverTo) }}</div>
                </div>
                <div class="field-group">{{ form_label(form.excerpt) }}{{ form_widget(form.excerpt) }}</div>
                <div class="field-group">{{ form_label(form.content) }}{{ form_widget(form.content) }}</div>
            </div>
            <div class="mt-6 flex items-center gap-3">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('admin_blog_index') }}" class="btn-link text-sm">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
