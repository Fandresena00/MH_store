{% extends 'admin/base.html.twig' %}
{% block header_title %}Journal{% endblock %}

{% block admin_body %}
    <div class="flex items-center justify-between mb-6">
        <form method="get" class="flex gap-2"><input type="search" name="q" value="{{ search }}" placeholder="Titre ou catégorie…"><button class="btn btn-outline">Rechercher</button></form>
        <p class="text-soft">{{ posts|length }} article(s)</p>
        <a href="{{ path('admin_blog_new') }}" class="btn btn-primary">+ Nouvel article</a>
    </div>

    <div class="table-card">
        <table>
            <thead><tr><th>Titre</th><th>Catégorie</th><th>Publié le</th><th></th></tr></thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td>{{ post.title }}</td>
                        <td class="text-soft">{{ post.category }}</td>
                        <td class="text-soft">{{ post.publishedAt|date('d/m/Y') }}</td>
                        <td class="text-right">
                            <a href="{{ path('admin_blog_edit', {id: post.id}) }}" class="btn-link">Modifier</a>
                            <form action="{{ path('admin_blog_delete', {id: post.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer cet article ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-post-' ~ post.id) }}">
                                <button type="submit" class="btn-danger" style="margin-left: 12px;">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
