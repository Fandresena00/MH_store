{% extends 'admin/base.html.twig' %}
{% block header_title %}Utilisateurs{% endblock %}

{% block admin_body %}
    <form method="get" class="mb-6 flex gap-2"><input type="search" name="q" value="{{ search }}" placeholder="Nom ou email…"><select name="role"><option value="">Tous les rôles</option><option value="admin" {{ activeRole == 'admin' ? 'selected' : '' }}>Administrateurs</option><option value="client" {{ activeRole == 'client' ? 'selected' : '' }}>Clients</option></select><button class="btn btn-outline">Filtrer</button></form>
    <p class="text-soft mb-6">{{ users|length }} compte(s)</p>

    <div class="table-card">
        <table>
            <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Inscrit le</th><th></th></tr></thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.fullName }}</td>
                        <td class="text-soft">{{ user.email }}</td>
                        <td>
                            {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                                <span class="badge-role">Super admin</span>
                            {% elseif 'ROLE_ADMIN' in user.roles %}
                                <span class="badge-role">Administrateur</span>
                            {% else %}
                                <span class="text-soft text-sm">Client</span>
                            {% endif %}
                        </td>
                        <td class="text-soft">{{ user.createdAt|date('d/m/Y') }}</td>
                        <td class="text-right">
                            {% if user != app.user and 'ROLE_SUPER_ADMIN' not in user.roles and 'ROLE_ADMIN' in user.roles %}
                                <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer cet administrateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-admin-' ~ user.id) }}">
                                    <button type="submit" class="btn-danger">Supprimer</button>
                                </form>
                            {% else %}
                                <span class="text-soft text-sm">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
