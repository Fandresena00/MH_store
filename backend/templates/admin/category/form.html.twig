{% extends 'admin/base.html.twig' %}
{% block header_title %}{{ category.id ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}{% endblock %}

{% block admin_body %}
    <div class="max-w-md">
        {{ form_start(form) }}
            <div class="card">
                <div class="field-group">{{ form_label(form.name) }}{{ form_widget(form.name) }}{{ form_errors(form.name) }}</div>
                <div class="field-group">{{ form_label(form.slug) }}{{ form_widget(form.slug) }}{{ form_errors(form.slug) }}</div>
            </div>
            <div class="mt-6 flex items-center gap-3">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('admin_category_index') }}" class="btn-link text-sm">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
